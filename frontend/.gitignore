# Frontend-level gitignore (Angular / Node)
# Root .gitignore covers most patterns — this file adds Angular-specific ones.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node modules
/node_modules

# Angular CLI cache
/.angular/cache

# Firebase (only ignore local cache, keep deployment config)
/.firebase/

# Test coverage
/coverage

# Environment files
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db
