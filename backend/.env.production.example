# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this to your Render dashboard environment variables
# DO NOT commit actual values to Git!
# =============================================================================

# Django Core Settings
DEBUG=False
DJANGO_SECRET_KEY=your-production-secret-key-generate-new-one-min-50-chars
ALLOWED_HOSTS=your-backend.onrender.com,your-custom-domain.com

# Frontend Configuration
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# Database (Automatically set by Render, don't set manually)
# DATABASE_URL=postgres://user:password@host:5432/database

# Redis (Automatically set by Render, don't set manually)
# REDIS_URL=redis://host:6379

# Celery (Automatically set by Render, don't set manually)
# CELERY_BROKER_URL=redis://host:6379/0
# CELERY_RESULT_BACKEND=redis://host:6379/0

# Email Configuration
USE_REAL_EMAIL=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yoursite.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# =============================================================================
# IMPORTANT NOTES:
# =============================================================================
# 
# 1. Generate a new SECRET_KEY for production:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 2. Update ALLOWED_HOSTS with your actual Render URL after deployment
#
# 3. Update CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS with your Vercel URL
#
# 4. For Gmail, use App Password (not regular password):
#    https://support.google.com/accounts/answer/185833
#
# 5. DATABASE_URL, REDIS_URL, CELERY settings are auto-populated by Render
#    from the render.yaml configuration
#
# =============================================================================
